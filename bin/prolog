#!/bin/sh
# bin/prolog [Dateien] [-g Ziel] [-q] [--no-edit] … – der Prolog-Toplevel
# wie `mix prolog`, aber mit +Bc: Ctrl-C bricht die laufende Anfrage ab
# (statt des BREAK-Menüs der BEAM). Zeilen liest der Zeileneditor der BEAM
# (Pfeiltasten, Verlauf, TAB-Completion); --no-edit liest wie früher
# zeilenweise von stdin (etwa für rlwrap; dann bricht Ctrl-C nichts ab).
# Dateinamen gelten relativ zum Verzeichnis, in dem man bin/prolog aufruft.
DIR=$(cd "$(dirname "$0")/.." && pwd)
PROLOG_EX_CWD=$(pwd)
export PROLOG_EX_CWD
cd "$DIR" || exit 1
exec elixir --erl "+Bc" -S mix prolog "$@"
