# Temporäre Datei sicher anlegen
tmp=$(mktemp "${TMPDIR:-/tmp}/rlwrap-completions.XXXXXX") || exit 1

# Aufräumen, auch bei Ctrl-C/TERM
trap 'rm -f "$tmp"' EXIT HUP INT TERM

printf '%s\n' "$completions" >"$tmp"

# Alle Argumente nach dem Wrapper unverändert an "mix prolog" weiterreichen.
exec rlwrap -A -a -e '' -f "$tmp" mix prolog --no-edit "$@"
