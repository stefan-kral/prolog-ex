#!/bin/sh

# start_ex [Argumente wie mix prolog] – PrologEx unter rlwrap:
# Zeilenbearbeitung, Verlauf und TAB-Completion (Wörter aus
# .rlwrap_completions im selben Verzeichnis). -I reicht Ctrl-C als SIGTERM
# weiter; PrologEx bricht damit die laufende Anfrage ab (SIGINT führte zum
# BREAK-Menü der BEAM). Ctrl-D beendet [user] bzw. die Sitzung.

DIR=$(cd "$(dirname "$0")" && pwd)

# +MMmcs 0: freigegebene Heap-Blöcke gehen an das System zurück, statt im
# Segment-Cache der BEAM zu bleiben (sonst hält ein großer Lauf hunderte MB
# fest: findall über 10^6 Werte +155 statt +68 MB). Kostet nur bei großen
# Heaps Zeit (etwa 10-25 %). Gesetzte ERL_FLAGS bleiben erhalten.
export ERL_FLAGS="+MMmcs 0${ERL_FLAGS:+ $ERL_FLAGS}"

# Aus jedem Verzeichnis startbar: mix braucht das Projektverzeichnis,
# PrologEx kehrt gleich zu Beginn ins Aufrufverzeichnis zurück
# (PROLOG_EX_CWD) – Dateien und working_directory/2 relativ zu ihm.
export PROLOG_EX_CWD="$PWD"
cd "$DIR" || exit 1

# Alle Argumente nach dem Wrapper unverändert an "mix prolog" weiterreichen.
exec rlwrap -A -a -I -e '' -f "$DIR/.rlwrap_completions" mix prolog --no-edit "$@"
