#!/bin/sh

# start_ex [Argumente wie mix prolog] – PrologEx unter rlwrap:
# Zeilenbearbeitung, Verlauf und TAB-Completion (Wörter aus
# .rlwrap_completions im selben Verzeichnis). -I reicht Ctrl-C als SIGTERM
# weiter; PrologEx bricht damit die laufende Anfrage ab (SIGINT führte zum
# BREAK-Menü der BEAM). Ctrl-D beendet [user] bzw. die Sitzung.
#
# Startet ohne mix direkt aus dem Build (etwa 0,3 s schneller): nach
# Änderungen an den Quellen selbst "mix compile" (oder "mix rebuild")
# aufrufen. Der Build: _build/dev, wie bei mix über MIX_ENV,
# MIX_BUILD_ROOT bzw. MIX_BUILD_PATH änderbar.

DIR=$(cd "$(dirname "$0")" && pwd)

# +MMmcs 0: freigegebene Heap-Blöcke gehen an das System zurück, statt im
# Segment-Cache der BEAM zu bleiben (sonst hält ein großer Lauf hunderte MB
# fest: findall über 10^6 Werte +155 statt +68 MB). Kostet nur bei großen
# Heaps Zeit (etwa 10-25 %). Gesetzte ERL_FLAGS bleiben erhalten.
export ERL_FLAGS="+MMmcs 0${ERL_FLAGS:+ $ERL_FLAGS}"

# Der Build. Fehlt er, Hinweis und Ende; sind Quellen neuer als die
# letzte Übersetzung, nur ein Hinweis (es läuft der alte Stand)
case "${MIX_BUILD_ROOT:=_build}" in /*) ;; *) MIX_BUILD_ROOT="$DIR/$MIX_BUILD_ROOT" ;; esac
APP="${MIX_BUILD_PATH:-$MIX_BUILD_ROOT/${MIX_ENV:-dev}}/lib/prolog_ex"
if [ ! -f "$APP/ebin/Elixir.PrologEx.Toplevel.beam" ]; then
  echo "start_ex: kein Build in $APP – bitte in $DIR \"mix compile\" aufrufen" >&2
  exit 1
fi
#
# Mix setzt die Zeit seines Manifests auf ganze Sekunden (den Beginn des
# Übersetzens); eine Datei, die in derselben Sekunde davor gespeichert
# wurde, wirkte für find -newer sonst neuer. Darum: find nur als Vorauswahl,
# dann in ganzen Sekunden vergleichen (stat: GNU -c %Y, BSD/macOS -f %m)
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }
MANIFEST="$APP/.mix/compile.elixir"
if [ -f "$MANIFEST" ]; then
  BUILT=$(mtime "$MANIFEST")
  find "$DIR/lib" "$DIR/mix.exs" -newer "$MANIFEST" -name '*.ex*' 2>/dev/null |
    while IFS= read -r f; do
      if [ "$(mtime "$f")" -gt "$BUILT" ]; then
        echo "% start_ex: Quellen geändert seit dem letzten Übersetzen – \"mix compile\" in $DIR" >&2
        break
      fi
    done
fi

# TAB-Ergänzung mit Klammern (use_module(library(clpz)), ...): ein
# rlwrap-Filter in Python (.rlwrap_filter.py), wenn rlwraps
# Filterbibliothek und python3 da sind – sonst nur die Wörter aus
# .rlwrap_completions
# (Filterbibliothek neben rlwrap: .../bin/rlwrap -> .../share/rlwrap/filters,
# bei Homebrew auch hinter dem Link; nicht über "rlwrap -z listing", das
# jeden Filter startet und Sekunden kostet)
FILTER=
RLW=$(command -v rlwrap)
for b in "$RLW" "$(readlink -f "$RLW" 2>/dev/null)"; do
  [ -n "$b" ] && [ -f "$(dirname "$b")/../share/rlwrap/filters/rlwrapfilter.py" ] && FILTER=y
done
if [ -n "$FILTER" ] && command -v python3 >/dev/null 2>&1; then
  FILTER="$DIR/.rlwrap_filter.py"
else
  FILTER=
fi

# Wörter: -b – nur diese Zeichen (und Leerraum) trennen, also sind auch
# =:= =.. \== Wörter (rlwrap trennt sonst an = + - : . usw.); "X=:" ohne
# Leerzeichen zerlegt der Filter selbst. -b muss vor -f stehen (so wird
# auch .rlwrap_completions gelesen)
#
# Alle Argumente nach dem Wrapper unverändert an PrologEx (wie "mix prolog
# --no-edit"; "--" beendet die Optionen von elixir). Prolog läuft im
# Aufrufverzeichnis: Dateien, consult/1, working_directory/2 relativ dazu
exec rlwrap -A -a -I -e '' -b "(){}[],;|!'\"%" -f "$DIR/.rlwrap_completions" ${FILTER:+-z "$FILTER"} \
  elixir -pa "$APP/consolidated" -pa "$APP/ebin" \
  -e 'System.halt(PrologEx.Toplevel.main(System.argv()))' -- --no-edit "$@"
